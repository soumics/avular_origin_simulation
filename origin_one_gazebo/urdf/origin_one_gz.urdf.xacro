<?xml version='1.0'?>

<!--
  Gazebo (Harmonic) overlay for the Avular Origin One.

  origin_one_description >= 2.0.0 contains only the hardware URDF; its
  CHANGELOG moves all Gazebo parameters to the simulation repos. This file
  includes that description unchanged and adds the Gazebo systems and sensors
  that origin_one_description 1.x (commit 051deab) used to carry, ported from
  Fortress (ignition-gazebo-*) to Harmonic (gz-sim-*) plugin names.
-->
<robot name="avular_origin_one" xmlns:xacro="http://ros.org/wiki/xacro" xmlns:gz="http://gazebosim.org/schema">

  <xacro:arg name="drive_configuration" default="skid_steer_drive"/>
  <xacro:arg name="prefix" default=""/>

  <xacro:include filename="$(find origin_one_description)/urdf/origin_one.urdf.xacro"/>

  <gazebo>
    <static>false</static>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat">
    </plugin>
  </gazebo>

  <!-- Wheel contact friction. Mecanum wheels use an anisotropic friction direction. -->
  <xacro:macro name="wheel_friction" params="name mecanum_fdir">
    <gazebo reference="${P}${name}">
      <collision>
        <surface>
          <friction>
            <xacro:if value="${var == 'mecanum_drive'}">
              <ode>
                <mu>1</mu>
                <mu2>0</mu2>
                <fdir1 gz:expressed_in="${P}base_link">${mecanum_fdir}</fdir1>
              </ode>
            </xacro:if>
            <xacro:unless value="${var == 'mecanum_drive'}">
              <ode>
                <mu>1</mu>
                <mu2>1</mu2>
                <slip1>0.015</slip1>
                <slip2>0</slip2>
                <fdir1>0 0 1</fdir1>
              </ode>
            </xacro:unless>
            <bullet>
              <friction>1</friction>
              <friction2>1</friction2>
              <rolling_friction>0.1</rolling_friction>
            </bullet>
          </friction>
        </surface>
      </collision>
    </gazebo>
  </xacro:macro>

  <xacro:wheel_friction name="left_front_wheel"  mecanum_fdir="1 -1 0"/>
  <xacro:wheel_friction name="right_front_wheel" mecanum_fdir="1 1 0"/>
  <xacro:wheel_friction name="left_rear_wheel"   mecanum_fdir="1 1 0"/>
  <xacro:wheel_friction name="right_rear_wheel"  mecanum_fdir="1 -1 0"/>

  <!-- Ouster OS1-32 lidar. Point cloud is published on /robot/lidar/points in frame os_lidar. -->
  <link name="${P}lidar_link_gazebo">
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
    <collision name="collision-base">
      <origin xyz="0 0 0.0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.07" radius="0.04"/>
      </geometry>
    </collision>
  </link>

  <joint type="fixed" name="${P}lidar_joint_gazebo">
    <origin xyz="0 0 0.035" rpy="0 0 0"/>
    <child link="${P}lidar_link_gazebo"/>
    <parent link="${P}ouster_base"/>
  </joint>

  <gazebo reference="${P}lidar_link_gazebo">
    <sensor name="ouster_lidar" type="gpu_lidar">
      <topic>/robot/lidar</topic>
      <gz_frame_id>${P}os_lidar</gz_frame_id>
      <update_rate>10</update_rate>
      <lidar>
        <scan>
          <horizontal>
            <samples>1024</samples>
            <resolution>1.0</resolution>
            <min_angle>-3.1415926</min_angle>
            <max_angle>3.1415926</max_angle>
          </horizontal>
          <vertical>
            <samples>32</samples>
            <resolution>1</resolution>
            <min_angle>-0.39</min_angle>
            <max_angle>0.39</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.08</min>
          <max>100.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
      <always_on>1</always_on>
      <visualize>true</visualize>
    </sensor>
  </gazebo>

  <!-- Realsense D435 (RGB-D). -->
  <gazebo reference="${P}camera_link">
    <sensor name="realsense_d435" type="rgbd_camera">
      <gz_frame_id>${P}camera_link</gz_frame_id>
      <topic>/robot/camera</topic>
      <update_rate>6</update_rate>
      <camera name="camera">
        <horizontal_fov>1.0472</horizontal_fov>
        <lens>
          <intrinsics>
            <!-- fx = fy = width / ( 2 * tan (hfov / 2 ) ) -->
            <fx>554.25469</fx>
            <fy>554.25469</fy>
            <!-- cx = ( width + 1 ) / 2 -->
            <cx>320.5</cx>
            <!-- cy = ( height + 1 ) / 2 -->
            <cy>240.5</cy>
            <s>0</s>
          </intrinsics>
        </lens>
        <distortion>
          <k1>0.0</k1>
          <k2>0.0</k2>
          <k3>0.0</k3>
          <p1>0.0</p1>
          <p2>0.0</p2>
          <center>0.5 0.5</center>
        </distortion>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.02</near>
          <far>300</far>
        </clip>
        <depth_camera>
          <clip>
            <near>0.1</near>
            <far>10</far>
          </clip>
        </depth_camera>
        <noise>
          <type>gaussian</type>
          <mean>0</mean>
          <stddev>0.007</stddev>
        </noise>
      </camera>
    </sensor>
  </gazebo>

  <!-- GNSS. -->
  <gazebo reference="${P}gnss_link">
    <sensor name="navsat" type="navsat">
      <gz_frame_id>${P}gnss_link</gz_frame_id>
      <always_on>1</always_on>
      <update_rate>10</update_rate>
      <topic>/robot/gnss</topic>
      <gps>
        <position_sensing>
          <horizontal>
            <!-- Noise in degrees: https://github.com/gazebosim/gz-sensors/issues/325 -->
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.0001</stddev>
            </noise>
          </horizontal>
          <vertical>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.0001</stddev>
            </noise>
          </vertical>
        </position_sensing>
      </gps>
    </sensor>
  </gazebo>

  <!-- Drive systems. Skid-steer variants use DiffDrive; mecanum uses MecanumDrive + OdometryPublisher. -->
  <xacro:macro name="diff_drive" params="max_linear max_angular">
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>${P}main_body_left_front_wheel</left_joint>
      <left_joint>${P}main_body_left_rear_wheel</left_joint>
      <right_joint>${P}main_body_right_front_wheel</right_joint>
      <right_joint>${P}main_body_right_rear_wheel</right_joint>
      <wheel_separation>0.45</wheel_separation>
      <wheel_radius>${wheelRadius}</wheel_radius>
      <max_linear_acceleration>5.5</max_linear_acceleration>
      <min_linear_acceleration>-5.5</min_linear_acceleration>
      <max_angular_acceleration>6</max_angular_acceleration>
      <min_angular_acceleration>-6</min_angular_acceleration>
      <max_linear_velocity>${max_linear}</max_linear_velocity>
      <min_linear_velocity>${-max_linear}</min_linear_velocity>
      <max_angular_velocity>${max_angular}</max_angular_velocity>
      <min_angular_velocity>${-max_angular}</min_angular_velocity>
      <topic>/robot/cmd_vel</topic>
      <odom_topic>/robot/odom</odom_topic>
      <tf_topic>/robot/tf</tf_topic>
      <frame_id>${P}odom</frame_id>
      <child_frame_id>${P}base_link</child_frame_id>
    </plugin>
  </xacro:macro>

  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/robot/joint_states</topic>
    </plugin>

    <xacro:if value="${var == 'skid_steer_drive'}">
      <xacro:diff_drive max_linear="1.5" max_angular="2"/>
    </xacro:if>

    <xacro:if value="${var == 'big_skid_steer_drive' or var == 'elevated_skid_steer_drive'}">
      <xacro:diff_drive max_linear="2.5" max_angular="3"/>
    </xacro:if>

    <xacro:if value="${var == 'mecanum_drive'}">
      <plugin filename="gz-sim-mecanum-drive-system" name="gz::sim::systems::MecanumDrive">
        <front_left_joint>${P}main_body_left_front_wheel</front_left_joint>
        <front_right_joint>${P}main_body_right_front_wheel</front_right_joint>
        <back_left_joint>${P}main_body_left_rear_wheel</back_left_joint>
        <back_right_joint>${P}main_body_right_rear_wheel</back_right_joint>
        <wheel_separation>${trackWidth}</wheel_separation>
        <wheelbase>${wheelbase}</wheelbase>
        <wheel_radius>${wheelRadius}</wheel_radius>
        <min_acceleration>-5</min_acceleration>
        <max_acceleration>5</max_acceleration>
        <topic>/robot/cmd_vel</topic>
      </plugin>

      <!-- MecanumDrive does not publish odometry, see https://github.com/gazebosim/gz-sim/pull/2297 -->
      <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
        <odom_topic>/robot/odom</odom_topic>
        <tf_topic>/robot/tf</tf_topic>
        <odom_frame>${P}odom</odom_frame>
        <robot_base_frame>${P}base_link</robot_base_frame>
      </plugin>
    </xacro:if>
  </gazebo>

</robot>
